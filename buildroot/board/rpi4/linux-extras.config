# ---------------------------------------------------------------------------
# Extra kernel config fragment for UVC gadget support on Raspberry Pi 4
# Applied on top of the bcm2711_defconfig.
# ---------------------------------------------------------------------------

# USB gadget framework
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y

# UVC function (depends on MEDIA_SUPPORT / VIDEO_DEV)
CONFIG_USB_CONFIGFS_F_UVC=y

# dwc2 OTG controller (Pi 4 USB-C port)
# Built-in so it is available before rootfs is mounted
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y

# V4L2 / Media subsystem required by UVC gadget function
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y

# Disable gadget drivers we do not need to keep the kernel lean
CONFIG_USB_ZERO=n
CONFIG_USB_AUDIO=n
CONFIG_USB_ETH=n
CONFIG_USB_G_NCM=n
CONFIG_USB_GADGETFS=n
CONFIG_USB_FUNCTIONFS=n
CONFIG_USB_G_PRINTER=n
CONFIG_USB_CDC_COMPOSITE=n
CONFIG_USB_G_SERIAL=n
CONFIG_USB_CONFIGFS_ACM=y

# Ethernet controller: not needed, probing adds ~2-3s even with no cable
CONFIG_BCMGENET=n

# Display pipeline: headless appliance, VC4/V3D initialisation saves ~1-2s
CONFIG_DRM_VC4=n
CONFIG_DRM_V3D=n

# Sound: nothing uses audio
CONFIG_SND=n

# Bluetooth: hardware disabled via overlay, remove the driver too
CONFIG_BT=n

# USB ethernet adapters: not used, skip probing them
CONFIG_USB_NET_SMSC95XX=n
CONFIG_USB_NET_LAN78XX=n
CONFIG_USB_NET_R8152=n

# Input: no mice or keyboards needed (serial console for debug)
CONFIG_INPUT_MOUSEDEV=n
CONFIG_USB_HID=n

# Hypervisor: not needed on embedded appliance
CONFIG_KVM=n

# Network filesystem cache: not needed
CONFIG_FSCACHE=n
CONFIG_CACHEFILES=n

# RAM disk: not needed
CONFIG_BLK_DEV_RAM=n

# Legacy RPi HDMI framebuffer: disabled in favour of serial console
CONFIG_FB_BCM2708=n
