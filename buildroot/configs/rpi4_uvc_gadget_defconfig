# ============================================================
# Minimal Raspberry Pi 4 (64-bit) UVC Gadget image
# ============================================================

# ------------------------------------------------------------
# Architecture – Cortex-A72, AArch64
# ------------------------------------------------------------
BR2_aarch64=y
BR2_cortex_a72=y

# ------------------------------------------------------------
# Toolchain – internal glibc (libgphoto2 requires glibc)
# ------------------------------------------------------------
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_USE_WCHAR=y
BR2_ENABLE_LOCALE=y
# Raspberry Pi downstream kernel is 6.6.x.  BR2_KERNEL_HEADERS_AS_KERNEL
# reuses the kernel source for toolchain headers, so we must declare the
# series via the "Custom kernel headers series" choice so the version check
# passes.
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y

# ------------------------------------------------------------
# System
# ------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="uvc-gadget"
BR2_TARGET_GENERIC_ISSUE="UVC Gadget"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_DEFAULT_PATH="/bin:/sbin:/usr/bin:/usr/sbin"
BR2_INIT_BUSYBOX=y

# ------------------------------------------------------------
# Linux kernel  (Raspberry Pi downstream kernel)
# Update the tarball hash to a newer 1.YYYYMMDD tag if desired:
#   https://github.com/raspberrypi/linux/tags
# ------------------------------------------------------------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,576cc10e1ed50a9eacffc7a05c796051d7343ea4)/linux-576cc10e1ed50a9eacffc7a05c796051d7343ea4.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# Our fragment enables USB gadget + UVC configfs
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_UVC_GADGET_PATH)/board/rpi4/linux-extras.config"
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="Image"

# ------------------------------------------------------------
# Raspberry Pi firmware / bootloader
# ------------------------------------------------------------
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
# We need the dwc2 overlay
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y

# ------------------------------------------------------------
# Packages  – keep only what is strictly needed
# ------------------------------------------------------------
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# libusb – required by libgphoto2
BR2_PACKAGE_LIBUSB=y

# libgphoto2 – Canon DSLR live view (PTP2 driver)
BR2_PACKAGE_LIBGPHOTO2=y

# Our application
BR2_PACKAGE_UVC_GADGET=y

# ------------------------------------------------------------
# Root filesystem
# ------------------------------------------------------------
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"

# ------------------------------------------------------------
# Post-build / post-image hooks
# ------------------------------------------------------------
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_UVC_GADGET_PATH)/board/rpi4/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_UVC_GADGET_PATH)/board/rpi4/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="support/scripts/genimage.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT_ARGS="-c $(BR2_EXTERNAL_UVC_GADGET_PATH)/board/rpi4/genimage.cfg"
